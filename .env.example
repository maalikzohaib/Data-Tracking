#  Shopify Business Tracker — Environment Variables
#  Copy this file to ".env" and fill in your real values.
#  (Vercel pe ye values "Environment Variables" section mein daalni hain)

# ---- Database (Neon / any Postgres) ----
# Neon dashboard se "Connection string" copy karo (pooled connection use karo).
DATABASE_URL=

# ---- Shopify Custom App ----
# Shopify Admin > Settings > Apps > Develop apps > Create app > Admin API access token
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Webhook verify secret (Shopify app > API credentials > "API secret key")
SHOPIFY_WEBHOOK_SECRET=

# ---- Meta (Facebook) Marketing API ----
# Meta > Business Settings > System User > Generate long-lived token (ads_read)
META_ACCESS_TOKEN=EAAxxxxxxxxxx
# Ad Account ID with "act_" prefix, e.g. act_1234567890
META_AD_ACCOUNT_ID=act_1234567890

# ---- Security ----
# Koi bhi lamba random string. Cron aur manual sync ko protect karta hai.
CRON_SECRET=change-me-to-a-long-random-string

# ---- App ----
# Default currency (sirf display ke liye)
NEXT_PUBLIC_CURRENCY=PKR
